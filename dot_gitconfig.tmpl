{{- $workOrg  := .work.org_slug -}}
{{- $profile := .profile -}}
[user]
	name = Marvin Dore
	email = hi@marvindore.com

[core]
    pager = delta
	longpaths = true
{{- if and (eq $profile "work") (eq .chezmoi.os "darwin") }}
	# GitGuardian secret scanning hooks, installed by ggshield.
	hooksPath = {{ .chezmoi.homeDir }}/Library/Application Support/ggshield/git-hooks
{{- end }}

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    hyperlinks = true
    conflict-style = diff3
    conflict-marker-begin = "▶ ▶ ▶ ▶ ▶"
    conflict-marker-end = "◀ ◀ ◀ ◀ ◀"
    # This makes the actual conflict area background dark red/blue
    minus-emph-style = "bold red 52"
    plus-emph-style = "bold green 22"

[merge]
    # Conflict resolution is diffview.nvim (`git mergetool`, `git dm`, shell
    # `gmerge`). Its 4-way layout (OURS | BASE | THEIRS over MERGED) parses
    # conflict markers directly, so one choose resolves a full conflict.
    # The raw nvimdiff tool is not used: its :diffget worked on diff hunks, not
    # conflict regions, so a single choose left half the conflict behind.
    tool = diffview
    conflictStyle = zdiff3

[mergetool]
    prompt = false
    keepBackup = false

# Opens diffview with the conflicted file selected. trustExitCode = false:
# git checks whether MERGED changed instead of trusting nvim's exit code.
[mergetool "diffview"]
    cmd = nvim -c \"DiffviewOpen --selected-file=$MERGED\"
    trustExitCode = false

[alias]
    # Difftastic aliases
    dl = -c diff.external=difft log --ext-diff
    ds = -c diff.external=difft show --ext-diff
    dd = -c diff.external=difft diff
    dlp = -c diff.external=difft log -p --ext-diff

    # Primary merge workflow: diffview.nvim resolves conflicts from the working
    # tree. `dm` opens diffview, checks for remaining conflict markers, then
    # stages everything on exit. `git mergetool` opens the same view one file
    # at a time (merge.tool).
    nvim-merge = "!nvim -c DiffviewOpen"
    dm = "!nvim -c DiffviewOpen && if grep -r '^<<<<<<<' . --exclude-dir=.git >/dev/null; then echo 'ERROR: Conflict markers remain'; exit 1; fi && git add . && echo \"Conflicts resolved. Ready to commit.\""

[difftool]
    difftool = true
    prompt = false

[pager]
    difftool = true

[diff]
    # Set difftastic as the default difftool, so we don't need to specify
    # `-t difftastic` every time.
    tool = difftastic

[difftool "difftastic"]
    prompt = false
	cmd = difft "$LOCAL" "$REMOTE"

{{ if eq .chezmoi.os "windows" -}}
[gpg]

    program = C:\\Program Files (x86)\\gnupg\\bin\\gpg.exe

[safe]
	directory = C:/Projects

# Force lfs to use https because ssh not working: failing command (GIT_TRACE=1 GIT_CURL_VERBOSE=1 git lfs pull)
# set for your local profile: git config --local lfs.url (company-https-url)/info/lfs
#[lfs]
# url = (company-https-url)/info/lfs
# User different gitconfig based on directory
{{ end -}}

# Work: HTTPS only, authenticated by gh. Catches copy-pasted SSH clone URLs
# and SSH submodule URLs; without it they hit the git@home: rule below and
# fail with the personal key. Longest-prefix match wins, so this rule beats
# the personal catch-all.
[url "https://github.com/{{$workOrg}}/"]
    insteadOf = git@github.com:{{$workOrg}}/

# Personal: SSH via the `home` host alias in ~/.ssh/config.
# Only the ssh form is rewritten. Rewriting https://github.com/ would also
# capture public https submodules in third-party repos and force them through
# the personal key, breaking unauthenticated read access.
[url "git@home:"]
    insteadOf = git@github.com:

# HTTPS auth uses the token from `gh auth login`. The empty helper clears
# system defaults (osxkeychain, manager) so only gh answers for github.com.
# Set here instead of `gh auth setup-git`, because chezmoi owns ~/.gitconfig.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[includeIf "hasconfig:remote.*.url:https://github.com/{{$workOrg}}/**"]
    path = .gitconfig-work
# Matches the raw URL in .git/config, before insteadOf, for clones made from SSH URLs.
[includeIf "hasconfig:remote.*.url:git@github.com:{{$workOrg}}/**"]
    path = .gitconfig-work
