brew "docker-compose"
brew "dua-cli"
brew "eza"
brew "fd"
brew "ffmpeg"
brew "fx"
brew "fzf"
brew "gcc" # optional, heavy; Apple clang covers most needs
brew "gh"
brew "git"
brew "git-delta"
brew "git-filter-repo"
brew "git-lfs"
brew "gnupg"
brew "httpie"
brew "imagemagick"
brew "iproute2mac"
brew "jc"
brew "jq"
brew "just"
brew "k9s"
brew "lazydocker"
brew "lazygit"
brew "lnav"
