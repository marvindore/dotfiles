# Homebrew Bundle. Single source of truth for installed software.
# Edit with `chezmoi edit ~/.config/homebrew/Brewfile`, then `chezmoi apply`.
# Audit: `brew bundle check --verbose --global`, `brew bundle cleanup --global` (dry run). Remove extras: `bbclean`. Sync: `bbs`.
# Third-party taps: use the full name and `trusted: true` (Homebrew 7 tap trust lives in ~/.config/homebrew/trust.json).
# Profile: {{ .profile }}

# --- taps -------------------------------------------------------------------
tap "nikitabobko/tap"

# --- formulae ---------------------------------------------------------------
brew "act"
brew "age"
