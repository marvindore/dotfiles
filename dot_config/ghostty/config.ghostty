command = "/usr/bin/env zsh -l -c 'export PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.nix-profile/bin:/run/current-system/sw/bin:$PATH; tmux attach || tmux'"
theme = Catppuccin Mocha
macos-non-native-fullscreen = true

# Removes the title bar and traffic light buttons, but keeps rounded window corners
#macos-titlebar-style = hidden
# Keeps the title bar, but hides the close/minimize/maximize buttons
macos-window-buttons = hidden

# Font size toggle for cramped multi-pane views (e.g. `git mergetool`'s 4-pane
# nvimdiff layout): shrink to fit more text, then reset back to normal.
keybind = super+shift+m=set_font_size:9
keybind = super+0=reset_font_size

# Ghostty's default clear_screen only clears the primary screen, so it
# can't reach tmux's alternate-screen scrollback. Send tmux's prefix (C-b)
# + k instead, bound in tmux.conf to clear the pane and its history.
keybind = super+k=text:\x02k
