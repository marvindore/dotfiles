{{- if eq .profile "work" -}}
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.marvin-dore.affine-backup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ env "HOME" }}/.local/bin/backup-affine.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>14</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>{{ env "HOME" }}/.local/share/affine/backup.log</string>
	<key>StandardErrorPath</key>
	<string>{{ env "HOME" }}/.local/share/affine/backup.log</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
{{- end }}
