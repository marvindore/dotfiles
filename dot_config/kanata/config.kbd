;; Kanata configuration mapped from ZMK MoErgo GO60 keymaps
;; Ported for macOS laptop layout with visual key alignment

(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 200
  hold-time 200
  hrm-hold-time 280
)

(defalias
  ;; Home Row Mods (Left Hand)
  a_ctl (tap-hold-release $tap-time $hrm-hold-time a lctl)
  s_alt (tap-hold-release $tap-time $hrm-hold-time s lalt)
  d_cmd (tap-hold-release $tap-time $hrm-hold-time d lmet)
  f_rs  (tap-hold-release $tap-time $tap-time f (layer-toggle raise))

  ;; Home Row Mods (Right Hand)
  j_rs  (tap-hold-release $tap-time $tap-time j (layer-toggle raise))
  k_cmd (tap-hold-release $tap-time $hrm-hold-time k rmet)
  l_alt (tap-hold-release $tap-time $hrm-hold-time l ralt)
  semi_ctl (tap-hold-release $tap-time $hrm-hold-time ; rctl)

  ;; Bottom Row Shift Taps
  shft_bspc (tap-hold $tap-time $tap-time A-bspc lsft)
  shft_eq   (tap-hold $tap-time $tap-time = rsft)

  ;; Thumb / Space Layer Toggles
  spc_tgl (tap-hold $tap-time $tap-time spc (layer-toggle toggles))

  ;; Change Navigation Macros (Toggles layer)
  nxt (macro ] c)
  prv (macro [ c)

  ;; Layer Toggle Shortcuts
  mac (layer-toggle macros)
)

;; Physical macOS laptop keyboard layout source grid
(defsrc
  esc        f1         f2         f3         f4         f5         f6         f7         f8         f9         f10        f11        f12
  grv        1          2          3          4          5          6          7          8          9          0          -          =          bspc
  tab        q          w          e          r          t          y          u          i          o          p          [          ]          \
  caps       a          s          d          f          g          h          j          k          l          ;          '          ret
  lsft       z          x          c          v          b          n          m          ,          .          /          rsft
  lctl       lalt       lmet                                        spc                                         rmet       ralt
)

(deflayer base
  esc        f1         f2         f3         f4         f5         f6         f7         f8         f9         f10        f11        f12
  grv        1          2          3          4          5          6          7          8          9          0          -          =          bspc
  tab        q          w          e          r          t          y          u          i          o          p          [          ]          \
  esc        @a_ctl     @s_alt     @d_cmd     @f_rs      g          h          @j_rs      @k_cmd     @l_alt     @semi_ctl  '          ret
  @shft_bspc z          x          c          v          b          n          m          ,          .          /          @shft_eq
  lctl       lalt       lmet                                        @spc_tgl                                    rmet       ralt
)

(deflayer toggles
  _          _          _          _          _          _          _          _          _          _          _          _          _
  mute       f1         f2         f3         f4         f5         f6         f7         f8         f9         f10        f11        f12        bspc
  tab        S-tab      end        home       _          C-\        f12        f13        _          _          S-\        S-=        _          _
  _          @nxt       @prv       pgdn       pgup       A-z        left       down       up         right      S--        =          _
  caps       _          _          _          A-S-h      A-S-l      S-left     S-down     S-up       S-right    \          _
  _          _          _                                           _                                           _          _
)

(deflayer raise
  _          _          _          _          _          _          _          _          _          _          _          _          _
  grv        ,          =          .          ;          S-4        S-7        M-z        M-S-z      S-,        S-.        _          _          bspc
  S-1        S-,        S-9        S-0        S-.        S-/        M-c        7          8          9          S-]        S-\        _          _
  S-3        [          S-[        S-]        ]          S-8        M-v        4          5          6          .          S-'        _
  S-grv      S-6        S-\        -          S--        /          M-x        1          2          3          .          _
  _          _          _                                           0                                           _          _
)

(deflayer macros
  _          _          _          _          _          _          _          _          _          _          _          _          _
  _          _          _          _          _          _          _          _          _          _          _          _          _          _
  _          _          C-M-q      _          M-S-spc    _          _          M-S-u      C-S-i      _          _          _          _          _
  _          _          _          _          _          _          _          _          _          _          _          _          _
  _          _          _          C-S-c      _          M-S-b      _          C-S-m      _          _          _          _
  _          _          _                                           _                                           _          _
)


