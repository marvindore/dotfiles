-- ~/.hammerspoon/init.lua

-- Load machine-local scripts if present (not version controlled)
pcall(require, "local-scripts")

-- Ctrl + Esc → Ctrl + Shift + Tab
hs.hotkey.bind({ "ctrl" }, "escape", function()
    hs.eventtap.keyStroke({ "ctrl", "shift" }, "tab")
end)

-- Navigate or open SilverBullet PWA / Web App (alt+n)
-- Focuses SilverBullet PWA application on active monitor, or searches Chrome tabs, or opens local server
local SILVERBULLET_URL = "http://localhost:13001"

hs.hotkey.bind({"alt"}, "n", function()
    -- 1. Check if SilverBullet PWA app is running
    local sbApp = hs.application.find("SilverBullet")
    if sbApp and sbApp:isRunning() then
        sbApp:activate()
        hs.timer.usleep(100000)
        local win = sbApp:mainWindow() or (sbApp:allWindows() and sbApp:allWindows()[1])
        if win then
            win:focus()
            local activeScreen = hs.mouse.getCurrentScreen()
            win:moveToScreen(activeScreen)
        end
        return
    end

    -- 2. Attempt to launch SilverBullet PWA app if installed
    local launched = hs.application.launchOrFocus("SilverBullet")
    if launched then
        hs.timer.doAfter(0.3, function()
            local app = hs.application.find("SilverBullet")
            if app then
                app:activate()
                local win = app:mainWindow() or (app:allWindows() and app:allWindows()[1])
                if win then
                    win:focus()
                    local activeScreen = hs.mouse.getCurrentScreen()
                    win:moveToScreen(activeScreen)
                end
            end
        end)
        return
    end

    -- 3. Fallback: Search Chrome windows/tabs for SilverBullet or open URL
    local chrome = hs.application.find("Google Chrome")

    if chrome and chrome:isRunning() then
        chrome:activate()
        hs.timer.usleep(200000)

        local ok, result = hs.osascript.javascript([[
            var chrome = Application("Google Chrome");
            var notesFound = false;
            var windowIndex = -1;
            var tabIndex = -1;

            for (var w = 0; w < chrome.windows.length; w++) {
                var win = chrome.windows[w];
                for (var t = 0; t < win.tabs.length; t++) {
                    var tab = win.tabs[t];
                    if (tab.url().includes("13001") || tab.url().includes("silverbullet")) {
                        notesFound = true;
                        windowIndex = w;
                        tabIndex = t;
                        break;
                    }
                }
                if (notesFound) break;
            }

            JSON.stringify({ found: notesFound, windowIndex: windowIndex, tabIndex: tabIndex });
        ]])

        if ok and result then
            local decoded = hs.json.decode(result)
            if decoded.found and decoded.windowIndex >= 0 then
                local chromeWindows = chrome:allWindows()
                if chromeWindows[decoded.windowIndex + 1] then
                    local targetWindow = chromeWindows[decoded.windowIndex + 1]
                    targetWindow:focus()

                    local activeScreen = hs.mouse.getCurrentScreen()
                    targetWindow:moveToScreen(activeScreen)
                    hs.timer.usleep(200000)

                    hs.osascript.javascript([[
                        var chrome = Application("Google Chrome");
                        chrome.windows[]] .. decoded.windowIndex .. [[].activeTabIndex = ]] .. decoded.tabIndex .. [[ + 1;
                    ]])
                end
            else
                hs.osascript.javascript([[
                    var chrome = Application("Google Chrome");
                    var win = chrome.windows[0];
                    if (win) {
                        var newTab = chrome.Tab({ url: "]] .. SILVERBULLET_URL .. [[" });
                        win.tabs.push(newTab);
                    }
                ]])
            end
        end
    else
        hs.execute("open -a 'Google Chrome' '" .. SILVERBULLET_URL .. "'")
    end
end)

-- Scratchpad overlay (ctrl + alt + n)
local Scratchpad = require("scratchpad")
hs.hotkey.bind({ "ctrl", "shift" }, "n", Scratchpad.toggle)

-- Menu bar
require("menu-bar")

-- Whispr: voice dictation → tmux agent (F2 toggle)
local Whispr = require("whispr")
hs.hotkey.bind({}, "f13", Whispr.toggle)

-- Clear all notifications (ctrl+shift+x)
hs.hotkey.bind({"ctrl", "shift"}, "x", function()
    hs.execute("killall NotificationCenter")
end)

-- Toggle Notification Center
-- Maps Ctrl + Option + C to macOS's built-in Fn + N shortcut
hs.hotkey.bind({ "alt" }, "c", function()
  hs.eventtap.keyStroke({ "fn" }, "n")
end)


-- ---------------------------------------------------------------------
-- LeaderKeys 
-- ---------------------------------------------------------------------
local LeaderKey = require("modules.LeaderKey")
local Actions = require("modules.Actions")

local leader = LeaderKey.new({
    -- Press Option+L to start the leader sequence.
    modifiers = { "alt" },
    key = "space",

    showHelper = true,
    helperEntryEachLine = 4,
    helperEntryLengthInChar = 24,

    description = "Main Leader",
    loggerName = "LeaderKey",
    logLevel = "warning",
})

-- ---------------------------------------------------------------------
-- SuperCmd extensions
-- ---------------------------------------------------------------------


-- ---------------------------------------------------------------------
-- Speech group
-- ---------------------------------------------------------------------

-- leader:group("a", "Audio and Speech")

-- Leader, S, W
leader:bind(
    { "s", "w" },
    Actions.superCmdHotkey(
        "Command+Shift+W"
    ),
    "Whisper"
)

-- Leader, A, S
leader:bind(
    { "a", "s" },
    Actions.superCmdHotkey(
        "Command+Shift+S"
    ),
    "Speak"
)

-- ---------------------------------------------------------------------
-- Hammerspoon maintenance
-- ---------------------------------------------------------------------

leader:group("x", "Hammerspoon")

leader:bind(
    { "x", "r" },
    Actions.callback(function()
        hs.reload()
    end),
    "Reload Configuration"
)

