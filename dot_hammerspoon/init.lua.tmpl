-- ~/.hammerspoon/init.lua

-- Ctrl + Esc → Ctrl + Shift + Tab
hs.hotkey.bind({ "ctrl" }, "escape", function()
    hs.eventtap.keyStroke({ "ctrl", "shift" }, "tab")
end)

-- Navigate or open Chrome with URL (alt+n)
-- Searches all Chrome windows for notes URL, focuses window on active monitor, or opens new tab
{{ if eq .profile "work" -}}
local CHROME_URL = "http://localhost:13001"
{{ else -}}
local CHROME_URL = "http://affine.internal"
{{ end -}}

hs.hotkey.bind({"alt"}, "n", function()
    local chrome = hs.application.find("Google Chrome")

    if chrome and chrome:isRunning() then
        local windows = chrome:allWindows()
        local notesFound = false
        local foundWindow = nil
        local foundTabIndex = nil

        -- Search all Chrome windows for the notes URL
        for i, win in ipairs(windows) do
            win:focus()
            hs.timer.usleep(200000) -- 200ms delay for window focus to settle

            local result = hs.osascript.javascript([[
                var chrome = Application("Google Chrome");
                var notesFound = false;
                var tabIndex = -1;

                for (var w = 0; w < chrome.windows.length; w++) {
                    var win = chrome.windows[w];
                    for (var t = 0; t < win.tabs.length; t++) {
                        var tab = win.tabs[t];
                        if (tab.url().includes("13001") || tab.url().includes("affine.internal")) {
                            notesFound = true;
                            tabIndex = t;
                            break;
                        }
                    }
                    if (notesFound) break;
                }

                JSON.stringify({ found: notesFound, tabIndex: tabIndex });
            ]])

            if result then
                local decoded = hs.json.decode(result)
                if decoded.found then
                    notesFound = true
                    foundWindow = win
                    foundTabIndex = decoded.tabIndex
                    break
                end
            end
        end

        if notesFound and foundWindow then
            -- Activate the window with the notes app
            foundWindow:focus()

            -- Move window to the active monitor (the screen the cursor is currently on)
            local activeScreen = hs.mouse.getCurrentScreen()
            foundWindow:moveToScreen(activeScreen)
            hs.timer.usleep(200000)

            -- Activate the specific tab
            if foundTabIndex and foundTabIndex >= 0 then
                hs.osascript.javascript([[
                    var chrome = Application("Google Chrome");
                    var win = chrome.windows[0];
                    if (win && win.tabs.length > ]] .. foundTabIndex .. [[) {
                        win.activeTabIndex = ]] .. foundTabIndex .. [[ + 1;
                    }
                ]])
            end
        else
            -- Notes app not found in any window: open in active tab of focused window
            chrome:activate()
            hs.timer.usleep(200000)
            hs.osascript.javascript([[
                var chrome = Application("Google Chrome");
                var win = chrome.windows[0];
                if (win) {
                    win.activeTab.url = "]] .. CHROME_URL .. [[";
                }
            ]])
        end
    else
        -- Chrome not running: launch with URL
        hs.execute("open -a 'Google Chrome' '" .. CHROME_URL .. "'")
    end
end)

-- Scratchpad overlay (ctrl + alt + n)
local Scratchpad = require("scratchpad")
hs.hotkey.bind({ "ctrl", "shift" }, "n", Scratchpad.toggle)

-- Menu bar
require("menu-bar")

-- Whispr: voice dictation → tmux agent (F2 toggle)
local Whispr = require("whispr")
hs.hotkey.bind({}, "f13", Whispr.toggle)

-- Clear all notifications (ctrl+shift+x)
hs.hotkey.bind({"ctrl", "shift"}, "x", function()
    hs.execute("killall NotificationCenter")
end)

-- Load machine-local scripts if present (not version controlled)
pcall(require, "local-scripts")
