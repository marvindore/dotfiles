-- ~/.hammerspoon/init.lua

-- Load machine-local scripts if present (not version controlled)
pcall(require, "local-scripts")

-- Ctrl + Esc → Ctrl + Shift + Tab
hs.hotkey.bind({ "ctrl" }, "escape", function()
    hs.eventtap.keyStroke({ "ctrl", "shift" }, "tab")
end)

-- Navigate or open SilverBullet PWA / Web App (alt+n)
-- Focuses SilverBullet PWA application on active monitor, or searches Chrome tabs, or opens the server URL.
-- Work: local server from start-silverbullet. Home: homelab URL from ~/.config/chezmoi/chezmoi.toml.
{{- $sbUrl := ternary "http://localhost:3010" .silverbulletUrl (eq .profile "work") }}
local SILVERBULLET_URL = {{ if eq $sbUrl "<place_holder>" }}nil{{ else }}{{ $sbUrl | quote }}{{ end }}

-- PWA windows live on AeroSpace workspace N.
-- Resolve the CLI path once at load. A login shell per keypress costs ~1s.
local AEROSPACE_BIN = nil
for _, path in ipairs({ "/opt/homebrew/bin/aerospace", "/usr/local/bin/aerospace" }) do
    if hs.fs.attributes(path) then
        AEROSPACE_BIN = path
        break
    end
end

-- Let AeroSpace place the window. Moving it with hs (moveToScreen) fights
-- AeroSpace and can strand the window off-screen on a hidden workspace.
local function showOnNotesWorkspace(app)
    local win = app:mainWindow() or app:allWindows()[1]
    if not win then return end
    if not AEROSPACE_BIN then
        win:focus()
        return
    end
    -- move-node-to-workspace is a no-op (and does not focus) when the window
    -- is already on N, so focus it in a second step.
    local id = tostring(win:id())
    hs.task.new(AEROSPACE_BIN, function()
        hs.task.new(AEROSPACE_BIN, nil, { "focus", "--window-id", id }):start()
    end, { "move-node-to-workspace", "--window-id", id, "N" }):start()
end

hs.hotkey.bind({"alt"}, "n", function()
    -- 1. Check if SilverBullet PWA app is running
    local sbApp = hs.application.find("SilverBullet")
    if sbApp and sbApp:isRunning() then
        showOnNotesWorkspace(sbApp)
        return
    end

    -- 2. Attempt to launch SilverBullet PWA app if installed
    local launched = hs.application.launchOrFocus("SilverBullet")
    if launched then
        hs.timer.doAfter(0.3, function()
            local app = hs.application.find("SilverBullet")
            if app then showOnNotesWorkspace(app) end
        end)
        return
    end

    -- 3. Fallback: Search Chrome windows/tabs for SilverBullet or open URL
    if not SILVERBULLET_URL then
        hs.alert.show("SilverBullet: set silverbulletUrl in ~/.config/chezmoi/chezmoi.toml, then chezmoi apply")
        return
    end
    local chrome = hs.application.find("Google Chrome")

    if chrome and chrome:isRunning() then
        chrome:activate()
        hs.timer.usleep(200000)

        local ok, result = hs.osascript.javascript([[
            var chrome = Application("Google Chrome");
            var notesFound = false;
            var windowIndex = -1;
            var tabIndex = -1;

            for (var w = 0; w < chrome.windows.length; w++) {
                var win = chrome.windows[w];
                for (var t = 0; t < win.tabs.length; t++) {
                    var tab = win.tabs[t];
                    if (tab.url().indexOf("]] .. SILVERBULLET_URL .. [[") === 0 || tab.url().includes("silverbullet")) {
                        notesFound = true;
                        windowIndex = w;
                        tabIndex = t;
                        break;
                    }
                }
                if (notesFound) break;
            }

            JSON.stringify({ found: notesFound, windowIndex: windowIndex, tabIndex: tabIndex });
        ]])

        if ok and result then
            local decoded = hs.json.decode(result)
            if decoded.found and decoded.windowIndex >= 0 then
                local chromeWindows = chrome:allWindows()
                if chromeWindows[decoded.windowIndex + 1] then
                    local targetWindow = chromeWindows[decoded.windowIndex + 1]
                    -- AeroSpace switches to the window's workspace. Do not move it with hs.
                    if AEROSPACE_BIN then
                        hs.task.new(AEROSPACE_BIN, nil, {
                            "focus", "--window-id", tostring(targetWindow:id()),
                        }):start()
                    else
                        targetWindow:focus()
                    end
                    hs.timer.usleep(200000)

                    hs.osascript.javascript([[
                        var chrome = Application("Google Chrome");
                        chrome.windows[]] .. decoded.windowIndex .. [[].activeTabIndex = ]] .. decoded.tabIndex .. [[ + 1;
                    ]])
                end
            else
                hs.osascript.javascript([[
                    var chrome = Application("Google Chrome");
                    var win = chrome.windows[0];
                    if (win) {
                        var newTab = chrome.Tab({ url: "]] .. SILVERBULLET_URL .. [[" });
                        win.tabs.push(newTab);
                    }
                ]])
            end
        end
    else
        hs.execute("open -a 'Google Chrome' '" .. SILVERBULLET_URL .. "'")
    end
end)

-- Menu bar
--require("menu-bar")

-- Clear all notifications (ctrl+shift+x)
hs.hotkey.bind({"ctrl", "shift"}, "x", function()
    hs.execute("killall NotificationCenter")
end)

-- Toggle Notification Center
-- Maps Ctrl + Option + C to macOS's built-in Fn + N shortcut
hs.hotkey.bind({ "alt" }, "c", function()
  hs.eventtap.keyStroke({ "fn" }, "n")
end)


-- ---------------------------------------------------------------------
-- LeaderKeys 
-- ---------------------------------------------------------------------
local LeaderKey = require("modules.LeaderKey")
local Actions = require("modules.Actions")

-- Starred-repo picker (alt+g). Star repos on GitHub to add them.
require("modules.RepoPicker").bind({ "alt" }, "g")

local leader = LeaderKey.new({
    -- Press Option+Space to start the leader sequence.
    modifiers = { "alt" },
    key = "space",

    showHelper = true,
    helperEntryEachLine = 4,
    helperEntryLengthInChar = 24,

    description = "Main Leader",
    loggerName = "LeaderKey",
    logLevel = "warning",
})

-- ---------------------------------------------------------------------
-- Search group
-- ---------------------------------------------------------------------

local Bookmarks = require("modules.Bookmarks")
local UrlBuilder = require("modules.UrlBuilder")

-- Leader, B
leader:bind(
    { "b" },
    Actions.callback(Bookmarks.show),
    "Bookmarks"
)

-- Leader, S, U
leader:bind(
    { "s", "u" },
    Actions.callback(UrlBuilder.show),
    "URL Builder"
)

-- ---------------------------------------------------------------------
-- AeroSpace
-- ---------------------------------------------------------------------

leader:group("a", "AeroSpace")

-- Same as AeroSpace service mode (alt+shift+;), then w.
-- run-callback exits non-zero when one window has no monitor, even if the
-- others moved. Ignore the exit code so that no false alert shows.
if AEROSPACE_BIN then
    leader:bind(
        { "a", "r" },
        Actions.shell(
            AEROSPACE_BIN .. " run-callback --for-every-window on-window-detected >/dev/null 2>&1; true",
            { successMessage = "AeroSpace window rules applied" }
        ),
        "Reapply Window Rules"
    )
end

-- Leader, N, G: notes file picker in tmux (was alt+shift+n).
leader:group("n", "Notes")

leader:bind(
    { "n", "g" },
    Actions.shell("~/.local/bin/tmux-workspace N && aerospace workspace T"),
    "Notes Grep (tmux)"
)

-- ---------------------------------------------------------------------
-- Hammerspoon maintenance
-- ---------------------------------------------------------------------

leader:group("x", "Hammerspoon")

leader:bind(
    { "x", "r" },
    Actions.callback(function()
        hs.reload()
    end),
    "Reload Configuration"
)

{{ if eq .profile "work" -}}
