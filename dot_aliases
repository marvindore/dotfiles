# Standard readable search
# - Case-insensitive
# - Groups matches by file
# - Shows line numbers
# Usage: rgh "search-term"
alias rgh='rg --heading --line-number --color=always -i'

# Search with 2 lines of context before and after each match
# Great for understanding surrounding code. Daily driver.
# Usage: rgc "search-term"
alias rgc='rg --heading --line-number --color=always -C 2 -i'

# Search with 5 lines of context
# Usage: rgc5 "search-term"
alias rgc5='rg --heading --line-number --color=always -C 5 -i'

# Show line + column numbers
# Useful when jumping to exact positions
# Usage: rgcol "search-term"
alias rgcol='rg --heading --line-number --column --color=always -i'

# Find files that contain the term (filenames only)
# Useful before opening files in editor
# Usage: rgf "search-term"
alias rgf='rg -l -i'

# Vim/IDE-friendly output
# Format: file:line:column:text
# Usage: rgv "search-term"
alias rgv='rg --vimgrep -i'

# Search only TypeScript files
# Usage: rgts "search-term"
alias rgts='rg -i -g "*.ts"'

# Search only TSX files
# Usage: rgtsx "search-term"
alias rgtsx='rg -i -g "*.tsx"'

# Search TS + TSX files
# Usage: rgreact "search-term"
alias rgreact='rg -i -g "*.ts" -g "*.tsx"'

# Search source code while ignoring common noise
# Usage: rgsrc "search-term"
alias rgsrc='rg -i \
  --glob "!node_modules/**" \
  --glob "!dist/**" \
  --glob "!build/**" \
  --glob "!.next/**"'

