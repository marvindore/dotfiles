###############################################################################
# HOMEBREW (source of truth: ~/.config/homebrew/Brewfile, managed by chezmoi)
###############################################################################

# Edit the Brewfile template, then apply. Installs anything new.
alias brewfile='chezmoi edit --apply ~/.config/homebrew/Brewfile'

# Install everything missing from the Brewfile. No upgrades.
alias bbi='HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle install --global'

# List what the Brewfile declares but is not installed.
alias bbc='brew bundle check --no-upgrade --verbose --global'

# List installed packages not in the Brewfile. Report only, never removes.
function bbx() {
  brew bundle cleanup --global </dev/null 2>&1 \
    | awk '/^Would uninstall/ { show=1 } /^Would `brew cleanup`/ { show=0 } show'
  return 0
}

# Remove installed packages not in the Brewfile. Preview first with `bbx`.
alias bbclean='brew bundle cleanup --force --global'

# Make the system match the Brewfile: install missing, then remove extras.
# Removes nothing if an install fails. No upgrades.
alias bbs='HOMEBREW_BUNDLE_NO_UPGRADE=1 brew bundle install --global --cleanup'

# Upgrade everything, then reconcile with the Brewfile.
function brewup() {
  brew update && brew upgrade && brew bundle install --global && brew cleanup
}
