# Project type detection with environment info
# Detects installed language versions (node, python, rust, go, etc.)
envcheck() {
  local parts=()

  # Node.js
  if command -v node &>/dev/null; then
    local node_ver=$(node --version 2>/dev/null | sed 's/v//')
    parts+=("🟢 node:$node_ver")
  fi

  # Python
  if command -v python3 &>/dev/null; then
    local py_ver=$(python3 --version 2>/dev/null | awk '{print $2}' | cut -d. -f1-2)
    if [[ -n "$VIRTUAL_ENV" ]]; then
      parts+=("🐍 python:$py_ver ✓")
    elif [[ -d .venv ]]; then
      parts+=("🐍 python:$py_ver (deactivated)")
    else
      parts+=("🐍 python:$py_ver")
    fi
  fi

  # Rust
  if command -v rustc &>/dev/null; then
    local rustc_ver=$(rustc --version 2>/dev/null | awk '{print $2}' | cut -d. -f1-2)
    parts+=("🦀 rust:$rustc_ver")
  fi

  # Go
  if command -v go &>/dev/null; then
    local go_ver=$(go version 2>/dev/null | awk '{print $3}' | sed 's/go//')
    parts+=("🐹 go:$go_ver")
  fi

  # C# / .NET
  if command -v dotnet &>/dev/null; then
    local dotnet_ver=$(dotnet --version 2>/dev/null)
    parts+=("🧬 dotnet:$dotnet_ver")
  fi

  # Java
  if command -v java &>/dev/null; then
    local java_ver=$(java -version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    parts+=("☕ java:$java_ver")
  fi

  # Ruby
  if command -v ruby &>/dev/null; then
    local ruby_ver=$(ruby --version 2>/dev/null | awk '{print $2}' | cut -d. -f1-2)
    parts+=("💎 ruby:$ruby_ver")
  fi

  if [[ ${#parts[@]} -eq 0 ]]; then
    echo "No recognized languages detected"
    return 0
  fi

  printf '%s\n' "${parts[@]}"
}
