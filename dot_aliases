# --- Check status ---
function kanata_status() {
    echo "--- Status ---"
    
    if pgrep -x "kanata" >/dev/null; then
        echo "🟢 Kanata: RUNNING (PID: $(pgrep -x kanata))"
    else
        echo "🔴 Kanata: STOPPED"
    fi

    # Check process AND Kernel status
    if pgrep -f "Karabiner-VirtualHIDDevice-Daemon" >/dev/null; then
        if ioreg -l | grep -q "Karabiner-DriverKit-VirtualHIDDevice"; then
             echo "🟢 Driver: RUNNING & LINKED (Ready)"
        else
             echo "YA Driver: RUNNING (But not linked to Kernel yet)"
        fi
    else
        echo "🔴 Driver: STOPPED"
    fi
}

function darwin_upgrade() {
  local dest_dir="$HOME/.config/nix-darwin"
  # Dynamically ask chezmoi for the source path
  local src_dir=$(chezmoi source-path "$dest_dir")

  # Safety check
  if [ ! -d "$src_dir" ]; then
    echo "Error: Cannot find chezmoi source directory at $src_dir."
    echo "Please ensure you have run 'chezmoi add ~/.config/nix-darwin'"
    return 1
  fi

  echo "Updating flake.lock in chezmoi source ($src_dir)..."
  cd "$src_dir" || return 1
  
  # Update happens in the source repo
  nix flake update
  
  # Push the freshly updated flake.lock to the system path
  echo "Applying updated lock file to system path..."
  chezmoi apply "$dest_dir"
  
  cd - > /dev/null
}

function darwin_update() {
  local dest_dir="$HOME/.config/nix-darwin"
  # Dynamically ask chezmoi for the source path
  local src_dir=$(chezmoi source-path "$dest_dir")

  # Safety check
  if [ ! -d "$src_dir" ]; then
    echo "Error: Cannot find chezmoi source directory at $src_dir."
    echo "Please ensure you have run 'chezmoi add ~/.config/nix-darwin'"
    return 1
  fi

  # 1. Move to the source directory to build.
  cd "$src_dir" || return 1
  echo "Building system configuration as unprivileged user..."
  nix build .#darwinConfigurations.mchip.system

  if [ $? -eq 0 ]; then
    # 2. If build succeeds, push the exact config/lock to the system
    echo "Syncing config and lock file to system..."
    chezmoi apply "$dest_dir"

    # 3. Switch the system using the newly synced destination files
    echo "Build successful. Switching system configuration as root..."
    sudo darwin-rebuild switch --flake "$dest_dir#mchip"
  else
    echo "Nix build failed. Aborting switch."
  fi

  # 4. Manage the garbage collection roots (now located in your source dir)
  rm -rf ./result
  cd - > /dev/null
}

function cht() {
# :list
# :learn
# sub topic
    if [ -z "$1" ]; then
        lang=$(curl -s cht.sh/:list | fzf)
    else
        lang="$1"
    fi

    [ -z "$lang" ] && return

    topic=$(
      {
        echo "ALL"
        curl -s "cht.sh/$lang/:list"
      } | fzf
    )

    [ -z "$topic" ] && return

    if [[ "$topic" == "ALL" ]]; then
      curl -s "cht.sh/$lang" | bat
    else
      curl -s "cht.sh/$lang/$topic" | bat
    fi
}

# markdown browser preview
mdp() {
  if [[ $# -eq 0 ]]; then
    pnpm dlx mdts --port 8521
  elif [[ -f "$1" ]]; then
    pnpm dlx mdts . -g "$1" "${@:2}" --port 8521
  else
    pnpm dlx mdts "$@" --port 8521
  fi
}


### Git
# Review exactly one commit
gv() {
  nvim "+DiffviewOpen ${1:-HEAD}^!"
}

# Review a range (examples: gvrange main..HEAD, gvrange HEAD~3..HEAD)
gvr() {
  if [ -z "$1" ]; then
    echo "usage: gvrange <rev-range>"
    return 1
  fi
  nvim "+DiffviewOpen $1"
}

# Review current working tree against index
gvw() {
  nvim "+DiffviewOpen"
}

# Check for git conflict markers in working tree
gcheck() {
  local files
  files=$(git ls-files -m | xargs grep -l '^<<<<<<<\|^=======\|^>>>>>>>' 2>/dev/null || true)
  if [ -z "$files" ]; then
    echo "No files with conflict markers found."
    return 0
  fi
  echo "Files with conflict markers:"
  echo "$files"
}

# Primary merge workflow: open diffview.nvim, which auto-detects conflicted
# files from the working tree. Resolve by conflict marker: <leader>co/ct/cb
# per conflict, <leader>cO/cT/cB for the whole file, ]x/[x to navigate.
gmerge() {
  if ! git ls-files -u | grep -q .; then
    echo "No conflicted files to resolve."
    return 0
  fi
  nvim -c DiffviewOpen
}

# Open conflicted files in kdiff3
gmergex() {
  local files
  files=$(git ls-files -m | xargs grep -l '^<<<<<<<\|^=======\|^>>>>>>>' 2>/dev/null)
  if [ -z "$files" ]; then
    echo "No conflicted files to resolve."
    return 0
  fi
  while IFS= read -r file; do
    git update-index --unresolve "$file"
    git mergetool --tool=kdiff3 "$file"
  done <<< "$files"
}

# File history for a path, defaulting to current directory
gvh() {
  nvim "+DiffviewFileHistory ${1:-.}"
}

# Repo-wide history
gvH() {
  nvim "+DiffviewFileHistory"
}

# Diff two arbitrary files from the shell
gvf() {
  if [ $# -ne 2 ]; then
    echo "usage: gvf <left-file> <right-file>"
    return 1
  fi
  nvim "+DiffviewDiffFiles $1 $2"
}

