{{- if eq .profile "work" -}}
#!/bin/bash

AFFINE_DIR="$HOME/.local/share/affine"

if ! command -v docker &> /dev/null; then
    echo "Docker is not installed or not in PATH. Skipping AFFiNE setup."
    exit 0
fi

# Ensure required .env file exists
if [ ! -f "$AFFINE_DIR/.env" ]; then
    echo "Creating .env file..."
    mkdir -p "$AFFINE_DIR"
    cat > "$AFFINE_DIR/.env" << 'ENVFILE'
AFFINE_REVISION=stable
PORT=13010
DB_DATA_LOCATION=./postgres
UPLOAD_LOCATION=./storage
CONFIG_LOCATION=./config
DB_USERNAME=affine
DB_PASSWORD=AffinePass123abc
DB_DATABASE=affine
ENVFILE
fi

# Ensure required docker-compose.yml exists
if [ ! -f "$AFFINE_DIR/docker-compose.yml" ]; then
    echo "Downloading docker-compose.yml from official AFFiNE release..."
    curl -sL -o "$AFFINE_DIR/docker-compose.yml" \
        https://github.com/toeverything/affine/releases/latest/download/docker-compose.yml || {
        echo "ERROR: Failed to download docker-compose.yml"
        exit 1
    }
fi

# Patch compose file to use variable substitution for AFFINE_REVISION
# Replace hardcoded :latest with variable reference
sed -i.bak 's|ghcr.io/toeverything/affine:latest|ghcr.io/toeverything/affine:${AFFINE_REVISION:-stable}|g' \
    "$AFFINE_DIR/docker-compose.yml"
rm -f "$AFFINE_DIR/docker-compose.yml.bak"

echo "Starting AFFiNE local environment..."
cd "$AFFINE_DIR" || exit

# Pull latest images to ensure we have the correct version
docker compose pull

# Start all services
docker compose up -d

# Wait for the server to be ready
echo "Waiting for AFFiNE server to start..."
max_attempts=30
attempts=0
while ! curl -sf http://localhost:13010/api/setup/user-exist &>/dev/null; do
    if [ $attempts -ge $max_attempts ]; then
        echo "WARNING: AFFiNE took longer than expected to start"
        break
    fi
    attempts=$((attempts + 1))
    sleep 1
done

echo "AFFiNE is running on http://localhost:13010"
echo "Visit http://localhost:13010/admin/setup to create the first admin account"
{{- end }}
