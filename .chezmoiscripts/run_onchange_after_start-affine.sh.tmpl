{{- if eq .profile "work" -}}
#!/bin/bash

# This hash ensures the script only runs if the docker-compose.yml changes.
# docker-compose.yml hash: {{ include "dot_local/share/affine/docker-compose.yml" | sha256sum }}

AFFINE_DIR="$HOME/.local/share/affine"

if ! command -v docker &> /dev/null; then
    echo "Docker is not installed or not in PATH. Skipping AFFiNE setup."
    exit 0
fi

echo "Starting/Updating AFFiNE local environment..."
cd "$AFFINE_DIR" || exit

# Bring up the containers in detached mode
docker compose up -d

echo "AFFiNE is running on http://localhost:13010"
{{- end }}
