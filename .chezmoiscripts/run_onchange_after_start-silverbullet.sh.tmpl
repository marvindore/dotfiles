{{- if eq .profile "work" -}}
#!/bin/bash
# Work profile only. Home uses the homelab SilverBullet.
# Starts colima when Docker is not running. Exits non-zero on failure, so the
# next `chezmoi apply` runs this script again.
set -euo pipefail

SILVERBULLET_DIR="$HOME/docker/silverbullet"
SILVERBULLET_SPACE="{{ .silverbulletSpacePath }}"

# chezmoi may run before the shell has Homebrew in PATH (first setup).
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    [ -x "$b" ] && eval "$("$b" shellenv)" && break
done

require_cmd() {
    command -v "$1" &>/dev/null && return 0
    echo "ERROR: $1 is not installed. Run 'bbi', then 'chezmoi apply'." >&2
    exit 1
}

ensure_docker_running() {
    docker info &>/dev/null && return 0
    echo "Docker is not running. Starting colima..."
    colima start
    docker info &>/dev/null && return 0
    echo "ERROR: Docker is still not reachable after 'colima start'." >&2
    exit 1
}

# Prefer the `docker compose` plugin. Fall back to the standalone binary,
# because Homebrew's docker-compose is not registered as a plugin by default.
compose() {
    if docker compose version &>/dev/null; then
        docker compose "$@"
    else
        docker-compose "$@"
    fi
}

export_certificates() {
    [ -f "$SILVERBULLET_DIR/ca-certificates.pem" ] && return 0
    echo "Exporting macOS system certificates..."
    security find-certificate -a -p /Library/Keychains/System.keychain > "$SILVERBULLET_DIR/ca-certificates.pem" 2>/dev/null || true
}

write_init_script() {
    [ -f "$SILVERBULLET_DIR/init-config.sh" ] && return 0
    echo "Creating init-config.sh..."
    cat > "$SILVERBULLET_DIR/init-config.sh" << 'INITSCRIPT'
#!/bin/sh
mkdir -p /space
if [ ! -f /space/CONFIG.md ]; then
    cat > /space/CONFIG.md << 'CONFIGEOF'
```space-lua
config.set {
  plugs = {
    "ghr:MrMugame/silversearch",
  }
}
```
CONFIGEOF
    echo "Created CONFIG.md with base plugins"
fi
INITSCRIPT
    chmod +x "$SILVERBULLET_DIR/init-config.sh"
}

write_compose_file() {
    [ -f "$SILVERBULLET_DIR/docker-compose.yml" ] && return 0
    echo "Creating docker-compose.yml..."
    cat > "$SILVERBULLET_DIR/docker-compose.yml" << COMPOSEFILE
services:
  silverbullet-init:
    image: alpine:latest
    container_name: silverbullet-init
    volumes:
      - "$SILVERBULLET_SPACE:/space"
      - "./init-config.sh:/init-config.sh:ro"
    command: sh /init-config.sh

  silverbullet:
    image: ghcr.io/silverbulletmd/silverbullet:latest
    container_name: silverbullet
    restart: unless-stopped
    depends_on:
      - silverbullet-init

    ports:
      - "127.0.0.1:3010:3000"

    environment:
      SSL_CERT_FILE: "/etc/ssl/certs/ca-certificates.pem"
      SSL_CERT_DIR: "/etc/ssl/certs"

    volumes:
      - "$SILVERBULLET_SPACE:/space"
      - "$HOME/docker/silverbullet/ca-certificates.pem:/etc/ssl/certs/ca-certificates.pem:ro"
COMPOSEFILE
}

wait_for_server() {
    echo "Waiting for SilverBullet server to start..."
    for _ in $(seq 1 30); do
        curl -sf http://localhost:3010/ &>/dev/null && return 0
        sleep 1
    done
    echo "WARNING: SilverBullet took longer than expected to start"
}

main() {
    require_cmd docker
    require_cmd colima
    ensure_docker_running

    mkdir -p "$SILVERBULLET_SPACE" "$SILVERBULLET_DIR"
    export_certificates
    write_init_script
    write_compose_file

    echo "Starting SilverBullet local environment..."
    cd "$SILVERBULLET_DIR"
    compose pull
    compose up -d
    wait_for_server
    echo "SilverBullet is running on http://localhost:3010"
}

main "$@"
{{- end }}
