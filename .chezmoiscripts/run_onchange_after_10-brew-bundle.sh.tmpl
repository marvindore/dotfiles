{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Reruns only when the rendered Brewfile changes:
# Brewfile: {{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . | sha256sum }}
set -eu
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$b" ] && eval "$("$b" shellenv)" && break
done
# NO_UPGRADE stops `install` from upgrading. `check` ignores the env var and needs the
# --no-upgrade flag, or it treats outdated formulae as unsatisfied. Upgrades belong to `brewup`.
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_BUNDLE_NO_UPGRADE=1
f="$HOME/.config/homebrew/Brewfile"
if brew bundle check --no-upgrade --file="$f" >/dev/null 2>&1; then
  echo "brew bundle: satisfied"
  exit 0
fi
brew bundle install --file="$f"
{{- end }}
